# ============================================================
# .gitignore — Hinglish Grounded Medical RAG
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.manifest
*.spec

# ---------- Virtual Environments ----------
.venv/
venv/
env/
ENV/

# ---------- Jupyter Notebooks ----------
.ipynb_checkpoints/
*.ipynb_meta

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Data (large files — do not commit) ----------
data/raw/
data/processed/
data/hmg/
data/external/
*.csv
*.tsv
*.parquet
*.json
!config/*.json
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz

# ---------- Model Weights & Checkpoints ----------
models/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf

# ---------- Medical Images ----------
*.dcm
*.dicom
*.nii
*.nii.gz

# ---------- Vector Stores / FAISS Indices ----------
indices/
*.index
*.faiss

# ---------- Logs & Outputs ----------
logs/
outputs/
wandb/
mlruns/
*.log

# ---------- Results ----------
# Ignore working artifacts, but VERSION the scored CSVs and reports.
# These are small (~16 MB total) and are the evidence behind every number in
# the paper. Keeping them untracked previously meant no reported result could
# be reproduced from a clone -- see plans/next-phase/unified-research-plan.md S3.
# NOTE: "results/**" (not "results/") is required -- git cannot re-include a
# file whose parent DIRECTORY is excluded.
results/**
!results/**/
!results/**/*.csv
!results/**/*.md
# Paper figures: small, and they ARE the deliverable. Versioned so a
# clone can check a figure against the CSV that produced it.
!results/**/*.png
!results/**/*.pdf

# ---------- Environment & Secrets ----------
.env
.env.*
# ...but the template carries no secrets and the README tells people to copy it
!.env.example
*.key
credentials/

# ---------- Misc ----------
*.zip
*.tar.gz
*.rar
*.7z
# checkpoints ARE tracked: a crash otherwise loses thousands of paid API calls
!results/**/*_partial.csv

# ---------- LaTeX build artifacts ----------
research-paper/draft/*.aux
research-paper/draft/*.log
research-paper/draft/*.out
research-paper/draft/*.bbl
research-paper/draft/*.blg
research-paper/draft/*.spl
research-paper/draft/*.toc

# ---------- Zenodo staging (large derived artifacts, uploaded manually) ----------
zenodo-upload/**
!zenodo-upload/
!zenodo-upload/README.md
